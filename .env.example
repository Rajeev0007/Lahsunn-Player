PORT=3000

# ---------------------------------------------------------------------------
# yt-dlp — the audio engine
# ---------------------------------------------------------------------------
# yt-dlp is the sole engine for search and streaming. If it is not on PATH the
# server downloads the official standalone build once and caches it, so a plain
# Node host still works out of the box.
YTDLP_AUTO_DOWNLOAD=true

# Point at a specific binary instead of searching PATH.
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Where an auto-downloaded copy is kept (defaults to the system temp dir).
# YTDLP_DIR=/var/data/bin

# Extra yt-dlp knobs, useful if YouTube starts rate-limiting the server.
# YTDLP_FORMAT=bestaudio[ext=m4a]/bestaudio/best
# YTDLP_COOKIES=/path/to/cookies.txt
# YTDLP_PROXY=http://127.0.0.1:8080
# YTDLP_ARGS=--extractor-args youtube:player_client=android

# Hide anything longer than this from results, so hour-long "mix" uploads do not
# crowd out actual songs.
MAX_TRACK_MINUTES=20

# ---------------------------------------------------------------------------
# Playlist import (all optional — each importer degrades on its own)
# ---------------------------------------------------------------------------
# YouTube playlist links are resolved directly through yt-dlp.
#
# Spotify links are resolved through the Spotify Web API. Create an app at
# https://developer.spotify.com/dashboard — no redirect URI or user login is
# needed, this uses the client-credentials flow.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Last.fm imports (loved / top / recent tracks). Get a key at
# https://www.last.fm/api/account/create
# LASTFM_API_KEY=

# Safety cap on how many tracks a single import may pull in.
# IMPORT_MAX_TRACKS=500

# Advanced: point the importers at a regional proxy or a mock.
# SPOTIFY_AUTH_URL=https://accounts.spotify.com/api/token
# SPOTIFY_API_BASE=https://api.spotify.com/v1
# LASTFM_API_BASE=https://ws.audioscrobbler.com/2.0/

# ---------------------------------------------------------------------------
# CORS (optional)
# ---------------------------------------------------------------------------
# Only needed when the UI is hosted separately from the API (e.g. on Vercel).
#   CORS_ORIGIN=https://my-ui.vercel.app       (or a comma-separated list, or *)
# CORS_ORIGIN=
