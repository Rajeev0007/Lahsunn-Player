{
  "name": "Loru Player",
  "short_name": "Loru",
  "description": "Stream any song from YouTube, Spotify and Audius. No downloads, no account.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#07070c",
  "theme_color": "#07070c",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/img/logo-icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Search", "url": "./#/search", "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Your Library", "url": "./#/library" },
    { "name": "Link a playlist", "url": "./#/sources" }
  ]
}
