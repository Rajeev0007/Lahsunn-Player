PORT=3000

# ---------------------------------------------------------------------------
# Lavalink — server-side only. Never expose these to the browser or commit them.
# ---------------------------------------------------------------------------
# LAVALINK_HOST accepts a bare hostname, an IP, or a full URL. All of these work:
#   LAVALINK_HOST=127.0.0.1
#   LAVALINK_HOST=lava.example.com
#   LAVALINK_HOST=https://lava.example.com
#   LAVALINK_HOST=wss://lava.example.com/v4/websocket
LAVALINK_HOST=127.0.0.1

# Omit LAVALINK_PORT to use the scheme default (443 for https, 2333 for http).
# Leave it blank rather than guessing — a wrong port is the #1 cause of a node
# looking "dead". Note: if the port is wrong the server will probe a couple of
# sensible alternatives and log whichever one it ends up using.
LAVALINK_PORT=2333

# The node's `Authorization` password (server.password in application.yml).
LAVALINK_AUTH=youshallnotpass

# true if the node is behind HTTPS/TLS. Ignored when LAVALINK_HOST already
# includes a scheme.
LAVALINK_SECURE=false

# ---------------------------------------------------------------------------
# Audio (optional)
# ---------------------------------------------------------------------------
# Lavalink's REST API cannot hand back raw audio, so yt-dlp resolves a direct
# stream URL which this server proxies with HTTP range support.
#   auto   — try the optional node plugin route, then fall back to yt-dlp
#   ytdlp  — only use yt-dlp
#   plugin — only use the node's custom /youtube/stream route
STREAM_MODE=auto

# Only relevant if your node runs a custom audio-streaming plugin.
# LAVALINK_STREAM_ROUTE=/youtube/stream/{id}

# ---------------------------------------------------------------------------
# Playlist import (all optional — each importer degrades on its own)
# ---------------------------------------------------------------------------
# YouTube playlist links need nothing extra: they resolve through Lavalink's
# youtube source, which every node has.
#
# Spotify links resolve through Lavalink automatically IF your node runs the
# LavaSrc plugin with Spotify credentials. If it does not, set these two and the
# server falls back to the Spotify Web API. Create an app at
# https://developer.spotify.com/dashboard — no redirect URI or user login is
# needed, this uses the client-credentials flow.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Last.fm imports (loved / top / recent tracks). Get a key at
# https://www.last.fm/api/account/create
# LASTFM_API_KEY=

# Safety cap on how many tracks a single import may pull in.
# IMPORT_MAX_TRACKS=500

# Advanced: point the importers at a regional proxy or a mock.
# SPOTIFY_AUTH_URL=https://accounts.spotify.com/api/token
# SPOTIFY_API_BASE=https://api.spotify.com/v1
# LASTFM_API_BASE=https://ws.audioscrobbler.com/2.0/

# ---------------------------------------------------------------------------
# Music source
# ---------------------------------------------------------------------------
# Where search results come from.
#   auto     — Lavalink, automatically falling back to yt-dlp if the node is
#              offline. Recommended: the player keeps working either way.
#   lavalink — Lavalink only
#   ytdlp    — yt-dlp only; no Lavalink needed at all
SEARCH_BACKEND=auto

# Set this to let the owner switch the source at runtime from Settings.
# Leave it unset and the switch is disabled for everyone.
# ADMIN_TOKEN=pick-a-long-random-string

# Hide anything longer than this from results, so hour-long "mix" uploads do not
# crowd out actual songs.
MAX_TRACK_MINUTES=20

# ---------------------------------------------------------------------------
# yt-dlp provisioning
# ---------------------------------------------------------------------------
# Nothing plays without yt-dlp. If it is not on PATH the server downloads the
# official standalone build once and caches it, so a plain Node host still works.
YTDLP_AUTO_DOWNLOAD=true

# Point at a specific binary instead of searching PATH.
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Where an auto-downloaded copy is kept (defaults to the system temp dir).
# YTDLP_DIR=/var/data/bin

# Extra yt-dlp knobs, useful if YouTube starts rate-limiting the server.
# YTDLP_FORMAT=bestaudio[ext=m4a]/bestaudio/best
# YTDLP_COOKIES=/path/to/cookies.txt
# YTDLP_PROXY=http://127.0.0.1:8080
# YTDLP_ARGS=--extractor-args youtube:player_client=android
