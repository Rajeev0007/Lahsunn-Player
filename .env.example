PORT=3000

# ---------------------------------------------------------------------------
# Lavalink — server-side only. Never expose these to the browser or commit them.
# ---------------------------------------------------------------------------
# LAVALINK_HOST accepts a bare hostname, an IP, or a full URL. All of these work:
#   LAVALINK_HOST=127.0.0.1
#   LAVALINK_HOST=lava.example.com
#   LAVALINK_HOST=https://lava.example.com
#   LAVALINK_HOST=wss://lava.example.com/v4/websocket
LAVALINK_HOST=127.0.0.1

# Omit LAVALINK_PORT to use the scheme default (443 for https, 2333 for http).
# Leave it blank rather than guessing — a wrong port is the #1 cause of a node
# looking "dead". Note: if the port is wrong the server will probe a couple of
# sensible alternatives and log whichever one it ends up using.
LAVALINK_PORT=2333

# The node's `Authorization` password (server.password in application.yml).
LAVALINK_AUTH=youshallnotpass

# true if the node is behind HTTPS/TLS. Ignored when LAVALINK_HOST already
# includes a scheme.
LAVALINK_SECURE=false

# ---------------------------------------------------------------------------
# Audio (optional)
# ---------------------------------------------------------------------------
# Lavalink's REST API cannot hand back raw audio, so yt-dlp resolves a direct
# stream URL which this server proxies with HTTP range support.
#   auto   — try the optional node plugin route, then fall back to yt-dlp
#   ytdlp  — only use yt-dlp
#   plugin — only use the node's custom /youtube/stream route
STREAM_MODE=auto

# Only relevant if your node runs a custom audio-streaming plugin.
# LAVALINK_STREAM_ROUTE=/youtube/stream/{id}

# Extra yt-dlp knobs, useful if YouTube starts rate-limiting the server.
# YTDLP_FORMAT=bestaudio[ext=m4a]/bestaudio/best
# YTDLP_COOKIES=/path/to/cookies.txt
# YTDLP_PROXY=http://127.0.0.1:8080
# YTDLP_ARGS=--extractor-args youtube:player_client=android
